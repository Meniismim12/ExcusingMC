DATABASE_URL="file:./dev.db"
PORT=4000
CORS_ORIGIN="*"

JWT_ACCESS_SECRET="dev-access-secret-almashtiring"
JWT_REFRESH_SECRET="dev-refresh-secret-almashtiring"
# 401 + refresh oqimini sinash uchun 2-kuni buni "45s" ga qo'ying —
# shunda token tez tugaydi va interceptor'ingiz haqiqatan ishlashini ko'rasiz.
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7

# --- Qiyinchilik rejimi ---
# Har bir so'rov shuncha ms kechikadi. 0 = kechikishsiz.
DELAY_MS=1000
# So'rovlarning shuncha ulushi ataylab 500 qaytaradi (0.15 = 15%). 0 = xatosiz.
# /auth/login va /auth/refresh bundan mustasno — aks holda interceptor aylanib qoladi.
CHAOS_RATE=0.15
